+static SceneDocument::TreeNode makeRawCodeNode(const QString &code, ParserState *state)
+{
+    SceneDocument::TreeNode node = makeGroupNode(SceneDocument::TreeNode::RawCode, state);
+    node.rawCode = code.trimmed();
+    return node;
