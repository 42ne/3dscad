+
+static QString consumeRawOpenScadSnippet(ParserState *state)
+{
+    if (!state || state->index >= state->lines.size())
+        return QString();
+
+    QString snippet;
+    int depth = 0;
+    bool consumedAny = false;
+    while (state->index < state->lines.size()) {
+        const ParsedLine &line = state->lines[state->index++];
+        if (!snippet.isEmpty())
+            snippet += QLatin1Char('\n');
+        snippet += line.text;
+        consumedAny = true;
+
+        for (const QChar ch : line.text) {
+            if (ch == QLatin1Char('{'))
+                ++depth;
+            else if (ch == QLatin1Char('}'))
